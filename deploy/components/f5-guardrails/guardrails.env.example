# Copy to guardrails.env (git-ignored) and fill in from your F5 AI Guardrails
# project. Check the request/response mapping against the API reference;
# see guardrail.external_scan() for how these are used.
GUARDRAIL_SCAN_URL=https://CHANGE-ME/scan-endpoint
GUARDRAIL_TOKEN=CHANGE-ME
GUARDRAIL_REQUEST_KEY=input
GUARDRAIL_EXTRA_JSON={}
GUARDRAIL_RESULT_PATH=result.outcome
GUARDRAIL_BLOCK_VALUES=flagged,blocked
